{
  "name": "getops",
  "version": "2.0.0",
  "description": "A persistent HFT trading-operations training workspace with evidence-based practice.",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "npm run legacy:build",
    "test": "npm run legacy:test",
    "legacy:build": "node legacy/web/build.mjs",
    "legacy:test": "npm run legacy:build && node --test legacy/tests/test_frontend_contract.mjs legacy/tests/test_build_contract.mjs",
    "legacy:test:server": "PYTHONDONTWRITEBYTECODE=1 python3 -m unittest discover -s legacy/tests -p 'test_*.py' -v",
    "content:extract": "node scripts/extract-legacy-content.mjs",
    "contracts:build": "npm run build --workspace @getops/contracts",
    "contracts:typecheck": "npm run typecheck --workspace @getops/contracts",
    "doctor": "./scripts/doctor.sh",
    "verify:release": "./scripts/verify-release.sh"
  },
  "dependencies": {
    "lucide": "1.24.0"
  },
  "engines": {
    "node": ">=22"
  }
}
